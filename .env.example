# Copy to .env and fill in. Never commit .env.

# Database. Leave empty for a local SQLite file (agentgrid.db).
# Postgres example: postgresql://agentgrid:agentgrid@localhost:5432/agentgrid
DATABASE_URL=

# LLM: any OpenAI-compatible API. Leave LLM_API_KEY empty to run without an LLM
# (answers are then extracted from the knowledge base, still with sources).
#   OpenAI: LLM_BASE_URL=https://api.openai.com/v1
#   Groq:   LLM_BASE_URL=https://api.groq.com/openai/v1
#   Gemini: LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# Use a model name your provider currently offers.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# Public URL of this server (used to verify Twilio signatures), e.g. https://agentgrid-poc.onrender.com
PUBLIC_BASE_URL=http://localhost:8000

# WhatsApp via Twilio (optional)
TWILIO_AUTH_TOKEN=
TWILIO_ACCOUNT_SID=
# The Twilio WhatsApp sender, e.g. +14155238886 for the sandbox
TWILIO_WHATSAPP_FROM=

# Platform operator key: unlocks /platform to create businesses and reset their admin keys.
# Leave empty to disable it. Use a long random value, e.g. from: python -c "import secrets;print(secrets.token_urlsafe(32))"
PLATFORM_ADMIN_KEY=
# Upper limit on businesses this deployment accepts
MAX_TENANTS=100

# Rate limits, requests per minute (0 turns a limit off)
RATE_LIMIT_PUBLIC_PER_MIN=30
RATE_LIMIT_ADMIN_PER_MIN=300
RATE_LIMIT_AUTH_FAILS_PER_MIN=10
# Number of proxies in front of the app that append to X-Forwarded-For (1 on Render). 0 = no proxy.
TRUSTED_PROXY_HOPS=0

# Comma-separated origins allowed to call the API from a browser. * allows any website to embed the widget.
# Each business can also limit its own widget key to its websites in the admin console.
CORS_ORIGINS=*
LOG_LEVEL=INFO
