# Copy to .env and fill in. Never commit .env.

# Database. Leave empty for a local SQLite file (agentgrid.db).
# Postgres example: postgresql://agentgrid:agentgrid@localhost:5432/agentgrid
DATABASE_URL=

# LLM: any OpenAI-compatible API. Leave LLM_API_KEY empty to run without an LLM
# (answers are then extracted from the knowledge base, still with sources).
#   OpenAI: LLM_BASE_URL=https://api.openai.com/v1
#   Groq:   LLM_BASE_URL=https://api.groq.com/openai/v1
#   Gemini: LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# Use a model name your provider currently offers.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# Public URL of this server (used to verify Twilio signatures), e.g. https://agentgrid-poc.onrender.com
PUBLIC_BASE_URL=http://localhost:8000

# WhatsApp via Twilio (optional)
TWILIO_AUTH_TOKEN=
TWILIO_ACCOUNT_SID=
# The Twilio WhatsApp sender, e.g. +14155238886 for the sandbox
TWILIO_WHATSAPP_FROM=

# Comma-separated origins allowed to call the API from a browser. * allows any website to embed the widget.
CORS_ORIGINS=*
LOG_LEVEL=INFO
